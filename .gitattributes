*.sh text eol=lf

# Force LF on Go source + JSON golden fixtures so Windows checkouts
# (with default core.autocrlf=true) don't trip byte-equal comparisons in
# acceptance/contract envelope tests.
*.go text eol=lf
cli/acceptance/testdata/**/*.json text eol=lf

# Preserve upstream notice bytes: release collectors verify their SHA-256,
# including original CRLF and trailing whitespace, on every platform.
licenses/** -text whitespace=-blank-at-eol,-blank-at-eof
THIRD_PARTY_NOTICES.md -text whitespace=-blank-at-eol
frontend/scripts/npm-license-sources/** -text
website-docs/scripts/npm-license-sources/** -text

# Unified diffs use a space to mark empty context lines.
patches/browserskill/*.patch whitespace=-blank-at-eol

# Keep deleted non-commercial sample parquet files deleted when merging upstream.
dataset/samples/*.parquet merge=ours

# Exclude internal compliance audit, rebrand notes, branch maintenance guides,
# AI assistant workspaces, release PoC notes, and CI/git metadata when exporting
# customer source archives via `git archive` (see scripts/export-source.sh).
COMMERCIAL_COMPLIANCE_AUDIT.md export-ignore
AUDIT_REPORT.md export-ignore
REBRAND_RESERVED.md export-ignore
BRANCH_GUIDE.md export-ignore
WEKNORA_RESIDUE_REMEDIATION.md export-ignore
test-reports export-ignore
test-reports/** export-ignore
tests/adversarial export-ignore
tests/e2e export-ignore
tests/stress export-ignore
.trellis export-ignore
.claude export-ignore
.agents export-ignore
.agents/** export-ignore
.github export-ignore
.gitattributes export-ignore
.gitignore export-ignore
*.gitkeep export-ignore
docs/superpowers export-ignore
docs/poc export-ignore
docs/design export-ignore
docs/images/readme/src export-ignore
misc/pr-assets export-ignore
scripts/verify-commercial-compliance.sh export-ignore
scripts/update-homebrew-formula.sh export-ignore
scripts/test-homebrew.sh export-ignore
scripts/git-hooks export-ignore
scripts/install-git-hooks.sh export-ignore
scripts/test-git-hooks.sh export-ignore
scripts/verify_frontend_pr.sh export-ignore
scripts/model_catalog_diff.py export-ignore
Formula export-ignore
# Exclude internal root deployment automation, while keeping runtime files such
# as website-docs/deploy/nginx.conf needed to build the customer source archive.
/deploy export-ignore
cli/AGENTS.md export-ignore
test_agent_config.sh export-ignore
rerank_server_demo.py export-ignore
