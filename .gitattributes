*.sh text eol=lf

# Force LF on Go source + JSON golden fixtures so Windows checkouts
# (with default core.autocrlf=true) don't trip byte-equal comparisons in
# acceptance/contract envelope tests.
*.go text eol=lf
cli/acceptance/testdata/**/*.json text eol=lf

# Unified diffs use a space to mark empty context lines.
patches/browserskill/*.patch whitespace=-blank-at-eol

# Keep deleted non-commercial sample parquet files deleted when merging upstream.
dataset/samples/*.parquet merge=ours

# Exclude internal compliance audit, rebrand notes, branch maintenance guides,
# AI assistant workspaces, release PoC notes, and CI/git metadata when exporting
# customer source archives via `git archive` (see scripts/export-source.sh).
