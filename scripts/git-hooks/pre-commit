#!/usr/bin/env bash
# Fast zero-exemption checks on staged files (whitespace, gofmt, golangci-lint, shellcheck, ruff).

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=scripts/git-hooks/common.sh
source "$ROOT/scripts/git-hooks/common.sh"

if hook_skip; then
  exit 0
fi

cd "$ROOT"

log_step "pre-commit"

check_whitespace --cached

staged_all=()
while IFS= read -r line; do
  [[ -n "$line" ]] && staged_all+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR || true)

staged_go=()
staged_sh=()
staged_py=()
for f in "${staged_all[@]}"; do
  case "$f" in
    *.go)
      staged_go+=("$ROOT/$f")
      ;;
    *.sh|scripts/git-hooks/pre-commit|scripts/git-hooks/pre-push)
      staged_sh+=("$ROOT/$f")
      ;;
    *.py)
      staged_py+=("$ROOT/$f")
      ;;
  esac
done

if [[ ${#staged_go[@]} -gt 0 ]]; then
  check_gofmt_files write "${staged_go[@]}"
fi

if [[ ${#staged_all[@]} -gt 0 ]]; then
  touched_modules=()
  while IFS= read -r mod; do
    [[ -n "$mod" ]] && touched_modules+=("$mod")
  done < <(detect_touched_go_modules "${staged_all[@]}")

  for mod in "${touched_modules[@]}"; do
    run_golangci_if_available "$mod"
  done
fi

if [[ ${#staged_sh[@]} -gt 0 ]]; then
  run_shellcheck_if_available "${staged_sh[@]}"
fi

if [[ ${#staged_py[@]} -gt 0 ]]; then
  run_ruff_if_available "${staged_py[@]}"
fi

log_ok "pre-commit passed"
