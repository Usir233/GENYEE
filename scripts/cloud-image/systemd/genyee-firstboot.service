[Unit]
Description=GENYEE first-boot initialization (runs once)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
Before=genyee.service
ConditionPathExists=/usr/local/sbin/genyee-firstboot.sh
ConditionPathExists=!/opt/GENYEE/.firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/genyee-firstboot.sh
RemainAfterExit=no
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
