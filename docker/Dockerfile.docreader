# =========================
# 构建阶段（轻量化：仅文档解析 + 图片提取，无 OCR/VLM）
# =========================
FROM python:3.12.16-bookworm AS builder

ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s@http://deb.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources && \
        sed -i "s@http://security.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
    fi

WORKDIR /app

# 安装构建依赖
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    libjpeg-dev \
    zlib1g-dev \
    libffi-dev \
    libgl1 \
    libglib2.0-0 \
    wget \
    antiword \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件（使用 venv 中的 grpc_tools.protoc 生成 protobuf 代码，无需外部 protoc 二进制）
COPY docreader/pyproject.toml docreader/uv.lock ./
RUN pip install --no-cache-dir uv==0.13.0 --break-system-packages && \
    python -m uv sync --locked --no-dev

# 复制源代码和生成脚本
COPY docreader docreader

# 生成 protobuf 代码（使用 venv 中的 grpc_tools）
ENV PATH="/app/.venv/bin:${PATH}"
RUN chmod +x docreader/scripts/generate_proto.sh && \
    bash docreader/scripts/generate_proto.sh

# =========================
# 运行阶段（轻量化）
# =========================
FROM python:3.12.16-bookworm AS runner

ARG VERSION_ARG=unknown
ARG COMMIT_ID_ARG=unknown
ENV DOCREADER_VERSION=${VERSION_ARG} DOCREADER_COMMIT_ID=${COMMIT_ID_ARG}

ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s@http://deb.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources && \
        sed -i "s@http://security.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
    fi

WORKDIR /app

# 安装运行时依赖（已移除 OCR/PaddleOCR 相关依赖）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libjpeg62-turbo \
    wget \
    gnupg \
    openjdk-17-jre-headless \
    libgl1 \
    libglib2.0-0 \
    antiword \
    bubblewrap \
    tar \
    dpkg \
    libxinerama1 \
    libfontconfig1 \
    libdbus-glib-1-2 \
    libcairo2 \
    libcups2 \
    libglu1-mesa \
    libsm6 \
    libreoffice \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 grpc_health_probe（带固定版本与 SHA-256 哈希核验）
ARG TARGETARCH
RUN if [ -z "$TARGETARCH" ]; then \
        case $(uname -m) in \
            "x86_64") TARGETARCH="amd64" ;; \
            "aarch64") TARGETARCH="arm64" ;; \
            "armv7l") TARGETARCH="arm" ;; \
            *) echo "Unsupported architecture: $(uname -m)" && exit 1 ;; \
        esac; \
        echo "[自动检测] 架构: $TARGETARCH"; \
    else \
        echo "[BuildKit] 架构: $TARGETARCH"; \
    fi && \
    GRPC_HEALTH_PROBE_VERSION=v0.4.24 && \
    case $TARGETARCH in \
        "amd64") ARCH="amd64"; PROBE_SHA256="7e564681110ee4563637457b91e42f62f96b79618a835bb05ae2305acdcc3db0" ;; \
        "arm64") ARCH="arm64"; PROBE_SHA256="3759148e22a494149a4abae269adee0d20c428b966683426e2319f9047da521d" ;; \
        "arm") ARCH="arm"; PROBE_SHA256="997fa2dec02cea960c5fb74c67aa6dd3e79be14cd183b9221d43244a81564de7" ;; \
        *) echo "Unsupported architecture: $TARGETARCH" && exit 1 ;; \
    esac && \
    curl -fsSL -o /bin/grpc_health_probe "https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/grpc_health_probe-linux-${ARCH}" && \
    echo "${PROBE_SHA256}  /bin/grpc_health_probe" | sha256sum -c - && \
    chmod 0755 /bin/grpc_health_probe

# 从构建阶段复制已安装的依赖和生成的代码
ENV VIRTUAL_ENV=/app/.venv
COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

# 安装 Playwright 浏览器到共享只读目录（兼容非 root 用户运行）
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ARG PLAYWRIGHT_DOWNLOAD_HOST=""
ARG PLAYWRIGHT_WEBKIT_DOWNLOAD_HOST=""
RUN if [ -n "$PLAYWRIGHT_WEBKIT_DOWNLOAD_HOST" ]; then \
        PLAYWRIGHT_WEBKIT_DOWNLOAD_HOST="$PLAYWRIGHT_WEBKIT_DOWNLOAD_HOST" python -m playwright install webkit; \
    elif [ -n "$PLAYWRIGHT_DOWNLOAD_HOST" ]; then \
        PLAYWRIGHT_DOWNLOAD_HOST="$PLAYWRIGHT_DOWNLOAD_HOST" python -m playwright install webkit; \
    else \
        python -m playwright install webkit; \
    fi
RUN python -m playwright install-deps webkit && rm -rf /var/lib/apt/lists/*

COPY docreader/pyproject.toml docreader/uv.lock ./
COPY --from=builder /app/docreader docreader
COPY testdata/ /app/testdata/

# 随附许可证与第三方开源声明
LABEL org.opencontainers.image.vendor="GENYEE" \
      org.opencontainers.image.title="genyee-docreader" \
      org.opencontainers.image.licenses="LicenseRef-GENYEE-Commercial AND MIT"
COPY LICENSE THIRD_PARTY_NOTICES.md /licenses/
COPY licenses/ /licenses/licenses/

# 创建非特权运行用户与共享临时目录
ENV HOME=/home/appuser
RUN groupadd -g 10001 appuser && \
    useradd -u 10001 -g 10001 -m -s /usr/sbin/nologin appuser && \
    mkdir -p /tmp/docreader && \
    chown -R 10001:10001 /tmp/docreader /home/appuser && \
    chmod -R a+rX,go-w /app /ms-playwright /licenses

USER 10001:10001

# 暴露 gRPC 端口
EXPOSE 50051

# Probe ARM crypto instructions before importing native dependencies. The
# entrypoint only enables portable OpenSSL implementations after a SIGILL.
ENTRYPOINT ["/app/.venv/bin/python", "-m", "docreader.container_entrypoint"]
# Dependencies are installed from uv.lock at build time; do not mutate them at boot.
CMD ["/app/.venv/bin/python", "-m", "docreader.main"]
