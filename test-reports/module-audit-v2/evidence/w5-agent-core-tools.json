      "invariants_checked": [
        "All HITL, host-approval, and MCP OAuth prompts bind tenant identity to CallerFromContext(ctx).TenantID (resolving cross-unit note #71 in host_approval.go and mcp_oauth.go), enforce UTF-8 safe preview slicing, and re-run CastParams + ValidateParams on user-modified arguments in ConfirmedTool.",
        "Knowledge base, knowledge graph, wiki, document list, and data analysis tools strictly enforce tenant ownership, narrowed API-key/mention searchTargets (@kb, @tag, @file), fail-closed empty/whitespace target rejection, and shared-KB owner-tenant storage resolution.",
        "Conversation search requires non-empty authenticated ownerID and wraps historical message snippets in untrusted-data prompt-injection framing.",
        "DataAnalysisTool blocks DuckDB environment/filesystem/introspection functions (getenv, current_setting, read_*, duckdb_*, information_schema), isolates session-scoped SQL-quoted table names, and DatabaseQueryTool fails closed on nil DB or zero tenantID.",
        "Sandbox and skill file tools enforce absolute base directories, reject symlink targets and symlink/non-directory ancestors via StatSessionFile, serialize per-file mutations with lockSandboxFile, and prevent input map mutation and integer/float overflow panics."
      ],
      "findings": [
        {
          "id": "W5-TOOLS-001",
          "severity": "P1",
          "file": "internal/agent/tools/sequentialthinking.go:105-205",
          "summary": "SequentialThinkingTool.Execute mutated shared thoughtHistory and branches state without mutex protection and emitted non-deterministic map key ordering under concurrent tool invocations.",
          "regression_test": "TestSequentialThinkingConcurrentExecute",
          "commit": "94e890230c2ecc594460bb35937ff496be463407"
        },
        {
          "id": "W5-TOOLS-002",
          "severity": "P1",
          "file": "internal/agent/tools/host_approval.go:45-165, internal/agent/tools/mcp_oauth.go:40-85",
          "summary": "HostApprovals.attach and emitMCPOAuthRequiredNotice resolved tenantID via types.TenantIDFromContext(ctx) instead of types.CallerFromContext(ctx).TenantID on shared-agent workspaces (#71), and HostApprovals sliced WritePreview/Stdin by raw byte index across multi-byte UTF-8 runes.",
          "regression_test": "TestHostApprovalsUsesCallerWorkspaceAndValidUTF8Preview",
          "commit": "94e890230c2ecc594460bb35937ff496be463407"
        },
        {
          "id": "W5-TOOLS-003",
          "severity": "P1",
          "file": "internal/agent/tools/param_validate.go:95-155, internal/agent/tools/param_cast.go:80-135, internal/agent/tools/confirmed_tool.go:95-190",
          "summary": "ValidateParams and CastParams overflowed int64(float64) conversion at math.MaxInt64 / large float exponents, and ConfirmedTool executed decision.ModifiedArgs without re-running CastParams/ValidateParams while dropping inner OutputLimitChars, ExecutionTimeout, and Cleanup delegation.",
          "regression_test": "TestValidateParamsAcceptsMaxInt64AndConfirmedToolValidatesModifiedArgs",
          "commit": "94e890230c2ecc594460bb35937ff496be463407"
        },
        {
          "id": "W5-TOOLS-004",
          "severity": "P1",
          "file": "internal/agent/tools/skill_file.go:65-240",
          "summary": "WriteSkillFileTool and EditSkillFileTool accepted non-absolute skillDir paths, did not inspect ancestor components or target files via StatSessionFile to block symlink escapes, and lacked per-file lockSandboxFile serialization.",
          "regression_test": "TestSkillFileToolsRejectSymlinkTargetsAndAncestors",
          "commit": "94e890230c2ecc594460bb35937ff496be463407"
        },
        {
          "id": "W5-TOOLS-005",
          "severity": "P1",
          "file": "internal/agent/tools/scope_authorization.go:60-115, internal/agent/tools/search_knowledge.go:155-295, internal/agent/tools/query_knowledge_graph.go:70-120",
          "summary": "validateKnowledgeBaseIDsInSearchTargets ignored whitespace-only KB IDs, and SearchKnowledgeTool collapsed targets carrying ScopeTagIDs or DisableRecallThresholds into unfiltered whole-KB batches and treated malformed narrowed targets with empty KnowledgeIDs as unrestricted whole-KB searches.",
          "regression_test": "TestSearchKnowledgeEnforcesScopeTagIDsAndEmptyTargets",
          "commit": "94e890230c2ecc594460bb35937ff496be463407"
        },
        {
          "id": "W5-TOOLS-006",
          "severity": "P1",
          "file": "internal/agent/tools/search_conversations.go:75-175",
          "summary": "SearchConversationsTool did not fail closed when ownerID was blank, risked nil-element dereference on SearchMessages results, and returned raw cross-session user/assistant text without untrusted-data prompt-injection framing.",
          "regression_test": "TestSearchConversationsRequiresOwnerIDAndFramesUntrustedOutput",
          "commit": "94e890230c2ecc594460bb35937ff496be463407"
        },
        {
          "id": "W5-TOOLS-007",
          "severity": "P1",
          "file": "internal/agent/tools/data_analysis.go:195-965, internal/agent/tools/database_query.go:95-155",
          "summary": "DataAnalysisTool permitted DuckDB environment/file/catalog functions (getenv, current_setting, read_*, duckdb_*, information_schema), used session-colliding unquoted table names, re-materialized loaded knowledge files, and resolved shared-KB storage under viewer tenant instead of knowledge.TenantID; DatabaseQueryTool lacked nil DB and zero-tenant fail-closed guards.",
          "regression_test": "TestDataAnalysisBlocksDuckDBEnvFunctionsIsolatesTablesAndResolvesSharedStorage",
          "commit": "94e890230c2ecc594460bb35937ff496be463407"
        },
        {
          "id": "W5-TOOLS-008",
          "severity": "P1",
          "file": "internal/agent/tools/wiki_tools.go:240-360, internal/agent/tools/wiki_source_refs.go:95-175, internal/agent/tools/wiki_write_page.go:80-195, internal/agent/tools/wiki_replace_text.go:70-150, internal/agent/tools/wiki_rename_page.go:55-120, internal/agent/tools/wiki_delete_page.go:55-115, internal/agent/tools/wiki_flag_issue.go:85-145, internal/agent/tools/wiki_read_issue.go:45-95, internal/agent/tools/wiki_update_issue.go:45-115",
          "summary": "Wiki read/write/replace/flag tools failed to enforce narrowed @file/@tag scopes on linked page summaries and existing target pages, wiki_write_page left TenantID=0 and accepted arbitrary page_type or reserved 'index' writes, wiki_rename_page/wiki_delete_page failed to protect 'index' and 'summary/*' pages, and wiki issue tools lacked enum/slug validation.",
          "regression_test": "TestWikiToolsEnforceNarrowedScopePopulateTenantIDAndProtectIndex",
          "commit": "94e890230c2ecc594460bb35937ff496be463407"
        },
        {
          "id": "W5-TOOLS-009",
          "severity": "P2",
          "file": "internal/agent/tools/workspace_reader.go:95-145, internal/agent/tools/read_file.go:55-95, internal/agent/tools/read_file_attachment.go:45-85, internal/agent/tools/list_documents.go:95-155, internal/agent/tools/browserskill_schema.go:115-150, internal/agent/tools/browser_fill_secret.go:55-95, internal/agent/tools/product_docs.go:55-135, internal/agent/tools/work.go:65-165, internal/agent/tools/shell_exec_async.go:175-225",
          "summary": "renderFileLinePage panicked on negative LineOffset, ReadFileTool.WithAttachments(nil) panicked in ExecutionTimeout, ListDocumentsTool overflowed page*pageSize on large page inputs, observationTokensFromTextChars overflowed float-to-int to 1, BrowserFillSecret/ProductDocs/Work tools lacked nil dependency guards, and ShellExecAsyncTool mutated caller input.Env maps.",
          "regression_test": "TestToolsRejectNegativeLineOffsetPageOverflowAndNilDeps",
          "commit": "94e890230c2ecc594460bb35937ff496be463407"
        }
