  "ownership_design": {
    "save_results": "NewlyStored means physical upload created by this save, not merely represented by a returned URL.",
    "cleanup": "Resource tombstone commits before provider deletion; CreateBinding and ClaimUnboundDeletion share row lock and recheck active state; raw driver cleanup keeps previous DeleteFile behavior.",
    "attachments": "Ownerless upload and previews use independent physical writes and are excluded from dedup lookup. Extracted preview binds to attachment parent resource; parent tombstone cascades child deletion; dependency retained until physical child delete succeeds.",
    "dedup": "Persistent tenant image reuse retained and restricted to concrete storage backend; no blanket dedup disabling.",
    "partial_failure": "Newly-created uploads release only this failed document owner then undergo atomic cleanup; reused resources retain original ownership.",
    "retry": "Provider failures leave addressable catalog tombstones, retained parent-child work items, and artifact tombstone backend metadata; repeated physical not-found treated idempotently."
  },
