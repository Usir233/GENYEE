  "findings": [
    {
      "id": "STO-001",
      "severity": "P1",
      "title": "Resolver/inline-guard rollback deletes reused images owned by another document",
      "provenance": "Parent external reproducer promoted to durable real SQLite/files regression",
      "reproducer": "go test ./internal/application/service -run ^TestSharedImageSurvivesResolverRollback$ -count=1",
      "failing_log": ".git/storage-before.log",
      "status": "fixed",
      "fix": "Explicit created/reused save result; rollback cleans created uploads only through binding-aware atomic cleanup"
    },
    {
      "id": "STO-002",
      "severity": "P1",
      "title": "Bind/cleanup race creates dangling bindings and manual ingestion swallows binding failure",
      "provenance": "Source trace plus baseline overlay of repository and knowledge caller implementations",
      "reproducer": "go test -overlay .git/module-audit-20261113/storage-baseline/overlay.json ./internal/application/service -run Test\\(StaleResourceBindingCannotReviveDeletedResource\\|ManualImageBindingFailureStopsChunkPersistence\\) -count=1",
      "failing_log": ".git/storage-binding-before.log",
      "status": "fixed",
      "fix": "Common row lock; active state recheck; tombstone before physical deletion; image-binding failures stop knowledge/temporary persistence; ownerless attachment writes isolated and attached to parent resources"
    },
    {
      "id": "STO-003",
      "severity": "P1",
      "title": "Content dedup returns a resource belonging to a different storage backend",
      "provenance": "Two temporary physical roots, backend-scoped drivers and real SQLite catalog",
      "reproducer": "go test ./internal/application/service -run ^TestImageDeduplicationDoesNotCrossStorageBackends$ -count=1",
      "failing_log": ".git/storage-backend-before.log",
      "status": "fixed",
      "fix": "Persistent content lookup scoped to concrete storage backend, including the process-global backend identity"
    },
    {
      "id": "STO-004",
      "severity": "P2",
      "title": "Cancellation during registration prevents cleanup of uploaded physical file",
      "provenance": "Real temporary local file plus cancellation-aware driver and injected registration cancellation",
      "reproducer": "go test ./internal/application/service/file -run ^TestFailedResourceRegistrationCleansUploadAfterCancellation$ -count=1",
      "failing_log": ".git/storage-registration-before.log",
      "status": "fixed",
      "fix": "Bounded five-second cleanup context detached from request cancellation"
    },
    {
      "id": "STO-005",
      "severity": "P1",
      "title": "Knowledge source-file deletion ignores shared owners and leaves stale source binding",
      "provenance": "Real knowledge repository fixture, independent SQLite resource catalog and local file",
      "reproducer": "go test ./internal/application/service -run ^TestKnowledgeSourceDeletionRespectsOtherOwners$ -count=1",
      "failing_log": ".git/storage-source-before.log",
      "status": "fixed",
      "fix": "Source ownership released before atomic cleanup in document/KB deletion, replacement and creation rollback"
    },
    {
      "id": "STO-006",
      "severity": "P2",
      "title": "COS temporary writes return an HTTPS path rejected by resource registration and cannot be read/deleted through the temporary client",
      "provenance": "Real COS SDK with in-memory HTTP transport, no external cloud calls",
      "reproducer": "go test -overlay .git/module-audit-20261113/storage-baseline/providers-overlay.json ./internal/application/service/file -run ^TestCOSTemporaryBytesUseResolvableResourcePaths$ -count=1",
      "failing_log": ".git/storage-provider-before.log",
      "status": "fixed_provider_group_frozen",
      "fix": "Canonical cos:// identity and temporary-bucket target selection for reads, signing, copying and deletion"
    },
    {
      "id": "STO-007",
      "severity": "P2",
      "title": "OBS proxy configuration turns write results into HTTPS presentation URLs rejected by catalog registration",
      "provenance": "Real AWS SDK OBS adapter with in-memory HTTP transport, no external cloud calls",
      "reproducer": "go test -overlay .git/module-audit-20261113/storage-baseline/providers-overlay.json ./internal/application/service/file -run ^TestOBSProxyBytesKeepProviderStorageIdentity$ -count=1",
      "failing_log": ".git/storage-provider-before.log",
      "status": "fixed_provider_group_frozen",
      "fix": "Always persist obs:// bucket/key identity; keep CDN proxy only in presentation URL generation"
    },
    {
      "id": "STO-008",
      "severity": "P1",
      "title": "Artifact cleanup trusts an advisory release count before a concurrent new binding",
      "provenance": "Real SQLite/file catalog with injected new binding immediately after artifact location lookup",
      "reproducer": "go test ./internal/handler/session -run ^TestArtifactCleanupRechecksBindingsAfterLocationLookup$ -count=1",
      "failing_log": ".git/storage-artifact-before.log",
      "status": "fixed",
      "fix": "Atomic DeleteUnboundFile after advisory release/location lookup, tombstone-aware backend lookup for retries"
    },
    {
      "id": "STO-009",
      "severity": "P1",
      "title": "Fresh artifact collection publishes a deduplicated resource deleted before its message binding",
      "provenance": "Real SQLite/local file interleaving invoked through ArtifactCollector.persistBytes",
      "reproducer": "go test ./internal/application/service -run '^TestNewArtifactCannotPublishAResourceRemovedBeforeBinding$' -count=1",
      "failing_log": ".git/storage-artifact-publish-before.log",
      "status": "fixed",
      "fix": "Require successful message claim before publishing; keep sandbox source for retry; clean only newly created unbound uploads"
    },
    {
      "id": "STO-010",
      "severity": "P1",
      "title": "Completion publishes delegated/history artifact references after their new owner binding fails",
      "provenance": "Actual AgentStreamHandler.handleComplete caller with selectively failing binding catalog; delegated and history subcases",
      "reproducer": "go test ./internal/handler/session -run '^TestCompletionPublishesOnlyArtifactsWithSuccessfulClaims$' -count=1",
      "failing_log": ".git/storage-inherited-before.log",
      "status": "fixed",
      "fix": "BindArtifactsToMessage returns only successful claims; completion attaches only those and removes failed Markdown download targets while preserving labels and existing resource owners for retry"
    }
  ],
